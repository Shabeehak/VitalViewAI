# VitalViewAI Environment Configuration = .env.example
# Copy this file to .env and fill in the values

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=False

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ML Server
ML_SERVER_HOST=0.0.0.0
ML_SERVER_PORT=8001
ML_SERVER_WORKERS=4
MODEL_TYPE=xgboost

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=vitalview
DB_USER=vitalview_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Connection pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0
REDIS_CACHE_TTL=3600

# ============================================================================
# SECURITY & ENCRYPTION
# ============================================================================

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=GENERATE_NEW_KEY_HERE

# Generate with: python -c "import os; print(os.urandom(32).hex())"
PATIENT_ID_SALT=GENERATE_NEW_SALT_HERE

# Generate with: openssl rand -hex 32
API_SECRET_KEY=GENERATE_NEW_SECRET_HERE

# JWT Configuration
JWT_SECRET_KEY=GENERATE_UNIQUE_JWT_KEY
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# ============================================================================
# MONITORING & LOGGING
# ============================================================================

# Grafana
GRAFANA_PASSWORD=CHANGE_ME

# Prometheus
PROMETHEUS_RETENTION_DAYS=30

# Log settings
LOG_ROTATION_SIZE=10485760  # 10MB
LOG_RETENTION_DAYS=90

# ============================================================================
# MODEL CONFIGURATION
# ============================================================================

# Model paths
XGBOOST_MODEL_PATH=models/xgboost_model.pkl
LSTM_MODEL_PATH=models/lstm_model.h5

# Prediction thresholds
LOW_RISK_THRESHOLD=0.3
MEDIUM_RISK_THRESHOLD=0.5
HIGH_RISK_THRESHOLD=0.7

# Model retraining
AUTO_RETRAIN_ENABLED=True
RETRAIN_SCHEDULE_CRON=0 2 * * 0  # Weekly on Sunday at 2 AM
MIN_SAMPLES_FOR_RETRAIN=1000

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/disable features
ENABLE_WEB_SEARCH=False
ENABLE_FEDERATED_LEARNING=False
ENABLE_DIFFERENTIAL_PRIVACY=False
ENABLE_MFA=True
ENABLE_AUDIT_LOGGING=True

# ============================================================================
# RATE LIMITING
# ============================================================================

# API rate limits
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
BURST_LIMIT=10

# ============================================================================
# BACKUP & DISASTER RECOVERY
# ============================================================================

# Backup configuration
BACKUP_ENABLED=True
BACKUP_SCHEDULE=0 1 * * *  # Daily at 1 AM
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=/backups

# ============================================================================
# COMPLIANCE
# ============================================================================

# HIPAA
HIPAA_COMPLIANCE_MODE=True
DATA_RETENTION_YEARS=7
AUDIT_LOG_RETENTION_YEARS=7

# GDPR
GDPR_COMPLIANCE_MODE=True
ALLOW_DATA_EXPORT=True
ALLOW_DATA_DELETION=True

# ============================================================================
# PERFORMANCE & SCALING
# ============================================================================

# Caching
ENABLE_CACHING=True
CACHE_PREDICTION_TTL=300  # 5 minutes
CACHE_FEATURES_TTL=600    # 10 minutes

# Batch processing
MAX_BATCH_SIZE=100
BATCH_TIMEOUT_SECONDS=30

# Connection timeouts
HTTP_TIMEOUT_SECONDS=30
DB_TIMEOUT_SECONDS=10

# ============================================================================
# DEVELOPMENT & TESTING
# ============================================================================

# Test mode 
TEST_MODE=False
MOCK_EXTERNAL_APIS=False
SEED_DATABASE=False

# Debug settings
ENABLE_DEBUG_ENDPOINTS=False
ENABLE_PROFILING=False