# docker/Dockerfile.api
# Streaming API Server - Production Ready
# Task 5: Scalability - Real-time patient data collection

FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first (for better Docker layer caching)
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY streaming_api_server.py .
COPY logging_config.py .
COPY privacy_utils.py .
COPY privacy_config.yaml .
COPY prometheus_metrics.py .

# Copy src directory (contains wearable_simulator and feature_engineering)
COPY src/ ./src/

# Create necessary directories
RUN mkdir -p logs data/runtime models config

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run with uvicorn
CMD ["uvicorn", "streaming_api_server:app", "--host", "0.0.0.0", "--port", "8000", "--log-level", "info"]